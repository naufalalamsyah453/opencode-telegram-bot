[Unit]
Description=OpenCode Telegram Bot
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/opt/opencode-telegram-bot
EnvironmentFile=/opt/opencode-telegram-bot/.env
ExecStart=/usr/bin/node /opt/opencode-telegram-bot/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
