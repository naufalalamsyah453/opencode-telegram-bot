# Telegram bot token from @BotFather
BOT_TOKEN=REPLACE_WITH_YOUR_TOKEN

# Only this Telegram user ID may control the bot
AUTHORIZED_USER_ID=REPLACE_WITH_YOUR_TELEGRAM_USER_ID

# Working directory for spawned commands
WORKDIR=/home/oc

# Timeouts (seconds)
RUN_TIMEOUT_SECONDS=600
COMMAND_TIMEOUT_SECONDS=300
TERM_TIMEOUT_SECONDS=600
TOOL_TIMEOUT_SECONDS=600
RUN_HARD_TIMEOUT_SECONDS=1200

# Fallback model handling
FALLBACK_RETRIES=2
# FALLBACK_MODELS=opencode/glm-5.3-flash-free,opencode/mimo-v2.6-flash-free

# Process timezone
TZ=Asia/Jakarta

# Optional template shown when a port-forward tunnel is needed
# VPS_SSH_HINT=ssh -L {port}:localhost:{port} -p 22 user@HOST -N
